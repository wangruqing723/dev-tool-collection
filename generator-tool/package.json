{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "generator-tool",
    "version": "1.0.1",
    "title": "Generator-Tool",
    "description": "字符生成工具（UUID、二维码、变量名转换、随机字符串）",
    "icon": "extension-icon.png",
    "author": "ruqing_wang",
    "owner": "ruqingwang-generator-tool",
    "access": "private",
    "categories": [
        "Developer Tools"
    ],
    "platforms": [
        "macOS",
        "Windows"
    ],
    "license": "MIT",
    "commands": [
        {
            "name": "uuid",
            "title": "UUID / GUID",
            "subtitle": "UUID 或 GUID 生成",
            "description": "随机 UUID 或 GUID 生成，支持指定结果样式",
            "mode": "no-view",
            "arguments": [
                {
                    "name": "type",
                    "type": "dropdown",
                    "placeholder": "选择生成类型",
                    "optional": true,
                    "data": [
                        {
                            "title": "UUID",
                            "value": "uuid"
                        },
                        {
                            "title": "GUID",
                            "value": "guid"
                        }
                    ]
                },
                {
                    "name": "dash",
                    "type": "dropdown",
                    "placeholder": "默认保留连字符",
                    "optional": true,
                    "data": [
                        {
                            "title": "去掉 -",
                            "value": "false"
                        },
                        {
                            "title": "保留 -",
                            "value": "true"
                        }
                    ]
                },
                {
                    "name": "upper",
                    "type": "dropdown",
                    "placeholder": "默认小写",
                    "optional": true,
                    "data": [
                        {
                            "title": "大写",
                            "value": "false"
                        },
                        {
                            "title": "小写",
                            "value": "true"
                        }
                    ]
                }
            ]
        },
        {
            "name": "qrcode",
            "title": "二维码",
            "subtitle": "二维码生成或转换",
            "description": "二维码生成或转换工具应用",
            "mode": "view"
        },
        {
            "name": "variable-name",
            "title": "变量名转换",
            "subtitle": "驼峰、蛇形等格式转换",
            "description": "变量名格式转换工具（驼峰、蛇形、帕斯卡等）",
            "mode": "view"
        },
        {
            "name": "random-string",
            "title": "随机字符串",
            "subtitle": "随机字符串生成",
            "description": "随机字符串生成工具应用程序",
            "mode": "no-view",
            "arguments": [
                {
                    "name": "length",
                    "description": "生成长度，1-1000，留空默认 16",
                    "type": "text",
                    "placeholder": "16",
                    "optional": true
                },
                {
                    "name": "charset",
                    "description": "字符集组合：l=小写字母  u=大写字母  d=数字  s=符号。可任意组合，顺序无关，留空默认 lud（小写+大写+数字）。例：ld=小写+数字，luds=全部",
                    "type": "text",
                    "placeholder": "l小写 u大写 d数字 s符号",
                    "optional": true
                }
            ]
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.104.17",
        "@raycast/utils": "^2.2.5",
        "qrcode": "1.5.4"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^2.0.4",
        "@types/jest": "^29.5.12",
        "@types/node": "^25.9.1",
        "@types/qrcode": "1.5.6",
        "@types/react": "^19.2.15",
        "eslint": "^10.4.0",
        "jest": "^29.7.0",
        "prettier": "^3.8.3",
        "ts-jest": "^29.1.2",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "build": "ray build",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "test": "jest",
        "test:watch": "jest --watch",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
        "publish": "npx @raycast/api@latest publish"
    }
}
